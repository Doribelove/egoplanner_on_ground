<?xml version="1.0"?>
<robot name="changfangti" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- 定义颜色 -->
  <material name="blue">
    <color rgba="0.2 0.5 0.8 1.0"/>
  </material>

  <!-- 单个刚体链接，无关节 -->
  <link name="base_link">
    <visual>
      <geometry>
        <!-- 尺寸：1040mm x 700mm x 430mm → 转换为米：1.040 x 0.700 x 0.430 -->
        <box size="1.040 0.700 0.430"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="1.040 0.700 0.430"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

</robot>
